# Local-only PDS secrets. Do not use in production or against bsky.social.
PDS_HOSTNAME=localhost
PDS_PORT=3000
PDS_JWT_SECRET=local-pds-jwt-secret-not-for-production
PDS_ADMIN_PASSWORD=local-pds-admin-password
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
PDS_DATA_DIRECTORY=/pds
PDS_BLOBSTORE_DISK_LOCATION=/pds/blocks
PDS_BLOB_UPLOAD_LIMIT=52428800
PDS_SERVICE_HANDLE_DOMAINS=.test
PDS_INVITE_REQUIRED=false
PDS_RATE_LIMITS_ENABLED=false
PDS_DEV_MODE=true
LOG_ENABLED=true
# AppView is not started here. Leave the official URLs so the PDS boots;
# app.bsky.* / chat / ozone still need a live AppView (see README).
PDS_BSKY_APP_VIEW_URL=https://api.bsky.app
PDS_BSKY_APP_VIEW_DID=did:web:api.bsky.app
PDS_REPORT_SERVICE_URL=https://mod.bsky.app
PDS_REPORT_SERVICE_DID=did:plc:ar7c4by46qjdydhdevvrndac
PDS_CRAWLERS=
