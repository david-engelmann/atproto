; Repo-drift gate: scans src/ + lexicons/official-nsids.json + skips.
; Not a package-install test. Keep this alias strict. Do not attach it
; to @runtest — opam with-test must not run it.

(executable
 (name test_lexicon_coverage)
 (flags
  (:standard -w +33 -warn-error +33))
 (modules test_lexicon_coverage)
 (libraries unix yojson ounit2 atproto))

(rule
 (alias lexicon-coverage)
 (deps
  ../lexicons/official-nsids.json
  ../lexicons/coverage-skips.json
  (source_tree ../src)
  test_lexicon_coverage.exe)
 (action
  (run ./test_lexicon_coverage.exe)))
