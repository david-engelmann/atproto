ATP_AUTH=your.name@email.com:pppp-ppp6-pp6p-ppp6
ATP_HOST=bsky.social
# ATP_SCHEME=https
# Official local network (scripts/local-atproto.sh / @atproto/dev-env@0.6.4):
# ATP_SCHEME=http
# ATP_HOST=localhost:2583
# ATP_APPVIEW_HOST=localhost:2584
# ATP_APPVIEW_DID=did:plc:...
# ATP_OZONE_HOST=localhost:2587
# ATP_OZONE_DID=did:plc:...
# PLC_ORIGIN=http://localhost:2582
# ATP_AUTH=alice.test:hunter2
# ATP_AUTH_BOB=bob.test:hunter2
# ATP_AUTH_OZONE=admin-mod.test:admin-mod-pass
# ATP_LOCAL_PDS=1
# Chat (not in the local TestNetwork). Proxy defaults to did:web:api.bsky.chat#bsky_chat.
# ATP_CHAT_DID=did:web:api.bsky.chat#bsky_chat
# ATP_CHAT=1
BASE_ENDPOINT=xrpc
REGISTRY_DB_CONNECTION_STRING=postgres://postgres:password@postgres_db:5432/registry?sslmode=disable
REDIS_ADDRESS=redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
POSTGRES_DB=registry
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
