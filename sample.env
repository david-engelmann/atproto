ATP_AUTH=your.name@email.com:pppp-ppp6-pp6p-ppp6
ATP_HOST=bsky.social
# ATP_SCHEME=https
# Official local network (scripts/local-atproto.sh / @atproto/dev-env@0.6.4):
# ATP_SCHEME=http
# ATP_HOST=localhost:2583
# ATP_APPVIEW_HOST=localhost:2584
# ATP_APPVIEW_DID=did:plc:...
# ATP_OZONE_HOST=localhost:2587
# ATP_OZONE_DID=did:plc:...
# PLC_ORIGIN=http://localhost:2582
# ATP_AUTH=alice.test:hunter2
# ATP_AUTH_BOB=bob.test:hunter2
# ATP_AUTH_OZONE=admin-mod.test:admin-mod-pass
# ATP_LOCAL_PDS=1
# Public-internet live hops (plc.directory, AppView, public PDS,
# firehose / Jetstream / did:web). Gates tests only — the README
# quick start talks to the public network without this. Unset by
# default: opam with-test and GitHub TestSuite stay offline.
# ATP_PUBLIC=1 (or true / yes / on) opts in. Local TestNetwork stays
# on ATP_LOCAL_PDS; credential hops stay on ATP_AUTH. Hosted-only
# products stay on ATP_SPACE / ATP_PHONE / ATP_PUSH / ATP_CHAT.
# ATP_PUBLIC=1
# Chat (not in the local TestNetwork). Hosted production path:
#   proxy did:web:api.bsky.chat#bsky_chat, host api.bsky.chat
#   OAuth: Oauth.default_chat_scope (transition:chat.bsky) or
#   include:chat.bsky.authFullChatClient; then getServiceAuth + *_service
# ATP_CHAT_DID=did:web:api.bsky.chat#bsky_chat
# ATP_CHAT_HOST=api.bsky.chat
# ATP_CHAT=1
# Video (not in the local TestNetwork). Hosted production path:
#   host video.bsky.app; service-auth aud = did:web:<pds> from
#   #atproto_pds, lxm = com.atproto.repo.uploadBlob
# ATP_VIDEO_HOST=video.bsky.app
# Permissioned data / spaces (proposal 0016 draft). There is no
# production or TestNetwork space host in this repo. Live
# com.atproto.space.* hops skip unless ATP_SPACE=1 and
# ATP_SPACE_HOST names a real host that serves the draft NSIDs.
# This library does not start or stub a space host.
# ATP_SPACE=1
# ATP_SPACE_HOST=
# Phone / contacts (hosted AppView SMS). Official TestNetwork has
# no phone gateway. ATP_PHONE=1 opts into live startPhoneVerification;
# ATP_PHONE_NUMBER must be a real E.164 number you own. Leave unset
# in CI. requestPhoneVerification / startPhoneVerification are not
# faked.
# ATP_PHONE=1
# ATP_PHONE_NUMBER=+12125550123
# Push (hosted notification service). Official Bluesky push is
# closed to the official app. Third-party clients supply their own
# gateway DID + device token. ATP_PUSH=1 opts into live
# registerPush. Leave unset in CI. This library does not invent a
# serviceDid or send APNs/FCM.
# ATP_PUSH=1
# ATP_PUSH_DID=did:web:push.example.org#bsky_notif
# ATP_PUSH_TOKEN=
# ATP_PUSH_APP_ID=org.example.app
# ATP_PUSH_PLATFORM=web
# Jetstream archive HTTP (Bluesky-hosted replay / snapshot). Live
# subscribeEvents stays unauthenticated. Create a key at
# https://bsky.network/account — this library does not invent one.
# Official SDK name is JETSTREAM_API_KEY; JETSTREAM_ARCHIVE_TOKEN is
# an alias. Pass the raw key (no "Bearer " prefix). Self-hosted
# Jetstream needs no key. Leave unset in CI.
# JETSTREAM_API_KEY=
# JETSTREAM_ARCHIVE_TOKEN=
BASE_ENDPOINT=xrpc
