ATP_AUTH=your.name@email.com:pppp-ppp6-pp6p-ppp6
ATP_HOST=bsky.social
# ATP_SCHEME=https
# Official local network (scripts/local-atproto.sh / @atproto/dev-env@0.6.4):
# ATP_SCHEME=http
# ATP_HOST=localhost:2583
# ATP_APPVIEW_HOST=localhost:2584
# ATP_APPVIEW_DID=did:plc:...
# ATP_OZONE_HOST=localhost:2587
# ATP_OZONE_DID=did:plc:...
# PLC_ORIGIN=http://localhost:2582
# ATP_AUTH=alice.test:hunter2
# ATP_AUTH_BOB=bob.test:hunter2
# ATP_AUTH_OZONE=admin-mod.test:admin-mod-pass
# ATP_LOCAL_PDS=1
# Chat (not in the local TestNetwork). Hosted production path:
#   proxy did:web:api.bsky.chat#bsky_chat, host api.bsky.chat
#   OAuth: Oauth.default_chat_scope (transition:chat.bsky) or
#   include:chat.bsky.authFullChatClient; then getServiceAuth + *_service
# ATP_CHAT_DID=did:web:api.bsky.chat#bsky_chat
# ATP_CHAT_HOST=api.bsky.chat
# ATP_CHAT=1
# Video (not in the local TestNetwork). Hosted production path:
#   host video.bsky.app; service-auth aud = did:web:<pds> from
#   #atproto_pds, lxm = com.atproto.repo.uploadBlob
# ATP_VIDEO_HOST=video.bsky.app
# Jetstream archive HTTP (Bluesky-hosted replay / snapshot). Live
# subscribeEvents stays unauthenticated. Create a key at
# https://bsky.network/account — this library does not invent one.
# Official SDK name is JETSTREAM_API_KEY; JETSTREAM_ARCHIVE_TOKEN is
# an alias. Pass the raw key (no "Bearer " prefix). Self-hosted
# Jetstream needs no key. Leave unset in CI.
# JETSTREAM_API_KEY=
# JETSTREAM_ARCHIVE_TOKEN=
BASE_ENDPOINT=xrpc
